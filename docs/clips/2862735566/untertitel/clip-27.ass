Dialogue: 0,0:00:00.00,0:00:01.52,Clip,,0,0,0,,politischer Bühne, auf
Dialogue: 0,0:00:01.52,0:00:03.80,Clip,,0,0,0,,einer hohen Ebene, wenn
Dialogue: 0,0:00:03.80,0:00:04.78,Clip,,0,0,0,,man solche Aussagen
Dialogue: 0,0:00:04.78,0:00:06.70,Clip,,0,0,0,,tätigt, wie ihr müsst
Dialogue: 0,0:00:06.70,0:00:07.84,Clip,,0,0,0,,jetzt den dritten Tempel
Dialogue: 0,0:00:07.84,0:00:08.92,Clip,,0,0,0,,bauen und das wird dann
Dialogue: 0,0:00:08.92,0:00:10.76,Clip,,0,0,0,,von Ministerpräsident zu
Dialogue: 0,0:00:10.76,0:00:11.70,Clip,,0,0,0,,keine Ahnung wem gesagt
Dialogue: 0,0:00:11.70,0:00:12.44,Clip,,0,0,0,,und das wird dann
Dialogue: 0,0:00:12.44,0:00:13.44,Clip,,0,0,0,,öffentlich gespreadert.
Dialogue: 0,0:00:13.50,0:00:14.10,Clip,,0,0,0,,Wenn ich mir so meine,
Dialogue: 0,0:00:14.20,0:00:14.68,Clip,,0,0,0,,ist das ernst?
Dialogue: 0,0:00:15.36,0:00:16.00,Clip,,0,0,0,,Das ist doch voll
Dialogue: 0,0:00:16.00,0:00:17.64,Clip,,0,0,0,,fanatisch eigentlich. Also
Dialogue: 0,0:00:17.64,0:00:18.54,Clip,,0,0,0,,wenn man doch den Frieden
Dialogue: 0,0:00:18.54,0:00:19.46,Clip,,0,0,0,,bewahren möchte, wenn man
Dialogue: 0,0:00:19.46,0:00:20.66,Clip,,0,0,0,,ja ein seriöser
