Dialogue: 0,0:00:00.00,0:00:01.32,Clip,,0,0,0,,mal hier gesagt werden das
Dialogue: 0,0:00:01.32,0:00:02.72,Clip,,0,0,0,,bitte verbreiten das ist
Dialogue: 0,0:00:02.72,0:00:03.74,Clip,,0,0,0,,die wichtigste Botschaft
Dialogue: 0,0:00:03.74,0:00:04.82,Clip,,0,0,0,,des tages wenn nicht des
Dialogue: 0,0:00:04.82,0:00:05.66,Clip,,0,0,0,,jahres wenn nicht des
Dialogue: 0,0:00:05.66,0:00:07.22,Clip,,0,0,0,,jahrzehnts das müsst ihr
Dialogue: 0,0:00:07.22,0:00:08.90,Clip,,0,0,0,,machen bitte verbreitet
Dialogue: 0,0:00:08.90,0:00:10.28,Clip,,0,0,0,,sowas und nicht wie
Dialogue: 0,0:00:10.28,0:00:12.50,Clip,,0,0,0,,irgendein ich raste hier
Dialogue: 0,0:00:12.50,0:00:13.66,Clip,,0,0,0,,wieder aus wie irgendein
Dialogue: 0,0:00:13.66,0:00:15.40,Clip,,0,0,0,,trottel keine ahnung milch
Dialogue: 0,0:00:15.40,0:00:16.28,Clip,,0,0,0,,trinkt und das aus seiner
Dialogue: 0,0:00:16.28,0:00:17.54,Clip,,0,0,0,,nase rauskommt und das als
Dialogue: 0,0:00:17.54,0:00:18.80,Clip,,0,0,0,,meme million klisch
Dialogue: 0,0:00:18.80,0:00:19.80,Clip,,0,0,0,,scheiss mal auf sowas
Dialogue: 0,0:00:19.80,0:00:21.18,Clip,,0,0,0,,leute wir brauchen keine
Dialogue: 0,0:00:21.18,0:00:22.32,Clip,,0,0,0,,fozeln und rübseln in
Dialogue: 0,0:00:22.32,0:00:23.52,Clip,,0,0,0,,leute sondern wir brauchen
Dialogue: 0,0:00:23.52,0:00:24.58,Clip,,0,0,0,,richtige message nach
Dialogue: 0,0:00:24.58,0:00:25.66,Clip,,0,0,0,,außen gebracht denn ihr
Dialogue: 0,0:00:25.66,0:00:26.80,Clip,,0,0,0,,wollt eine bessere welt
Dialogue: 0,0:00:26.80,0:00:28.42,Clip,,0,0,0,,dann tut was dafür
Dialogue: 0,0:00:28.42,0:00:30.40,Clip,,0,0,0,,wenn es ein böse und gutes
Dialogue: 0,0:00:30.40,0:00:31.92,Clip,,0,0,0,,geht der macht nur einen
Dialogue: 0,0:00:31.92,0:00:32.86,Clip,,0,0,0,,unterschied zwischen böse
Dialogue: 0,0:00:32.86,0:00:33.36,Clip,,0,0,0,,und gute
Dialogue: 0,0:00:34.00,0:00:35.40,Clip,,0,0,0,,dankeschön guck mal
Dialogue: 0,0:00:35.40,0:00:37.28,Clip,,0,0,0,,oder besser hätte
Dialogue: 0,0:00:37.28,0:00:39.54,Clip,,0,0,0,,besser besser kann man
Dialogue: 0,0:00:39.54,0:00:41.66,Clip,,0,0,0,,das nicht sagen macht
Dialogue: 0,0:00:41.66,0:00:43.14,Clip,,0,0,0,,unterschiede nur zwischen
