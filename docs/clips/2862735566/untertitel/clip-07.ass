Dialogue: 0,0:00:00.00,0:00:01.26,Clip,,0,0,0,,Ich habe auch dazu keine
Dialogue: 0,0:00:01.26,0:00:01.71,Clip,,0,0,0,,Meinung.
Dialogue: 0,0:00:02.26,0:00:02.96,Clip,,0,0,0,,Klar kann man sagen,
Dialogue: 0,0:00:03.22,0:00:03.92,Clip,,0,0,0,,Frauen schlagen geht
Dialogue: 0,0:00:03.92,0:00:04.82,Clip,,0,0,0,,nicht, okay, da sind wir
Dialogue: 0,0:00:04.82,0:00:05.50,Clip,,0,0,0,,uns {\c&H0022DDFF&}alle{\c&H00FFFFFF&} einig, aber
Dialogue: 0,0:00:05.50,0:00:06.16,Clip,,0,0,0,,darüber hinaus,
Dialogue: 0,0:00:06.80,0:00:07.52,Clip,,0,0,0,,was soll ich jetzt über
Dialogue: 0,0:00:07.52,0:00:08.32,Clip,,0,0,0,,ihn reden oder was?
Dialogue: 0,0:00:08.56,0:00:09.50,Clip,,0,0,0,,Also ich springe bestimmt
Dialogue: 0,0:00:09.50,0:00:11.70,Clip,,0,0,0,,nicht auf diesen Hype
Dialogue: 0,0:00:11.70,0:00:12.54,Clip,,0,0,0,,-Zug, wo jetzt {\c&H0022DDFF&}alle{\c&H00FFFFFF&}
Dialogue: 0,0:00:12.54,0:00:13.62,Clip,,0,0,0,,YouTuber und Streamer
Dialogue: 0,0:00:13.62,0:00:15.18,Clip,,0,0,0,,drauf springen, weil sie
Dialogue: 0,0:00:15.18,0:00:15.96,Clip,,0,0,0,,wissen, dass es generiert
Dialogue: 0,0:00:15.96,0:00:16.88,Clip,,0,0,0,,Klicks, weil {\c&H0022DDFF&}jeder{\c&H00FFFFFF&} gerade
Dialogue: 0,0:00:16.88,0:00:17.84,Clip,,0,0,0,,guckt, wie die Meinung des
Dialogue: 0,0:00:17.84,0:00:19.82,Clip,,0,0,0,,anderen ist. Aber ich habe
Dialogue: 0,0:00:19.82,0:00:20.82,Clip,,0,0,0,,eine ganz klare Meinung
Dialogue: 0,0:00:20.82,0:00:22.04,Clip,,0,0,0,,und meine Meinung ist, das
Dialogue: 0,0:00:22.04,0:00:23.24,Clip,,0,0,0,,geht mich ein feuchten
Dialogue: 0,0:00:23.24,0:00:24.62,Clip,,0,0,0,,Dreck an, was er mit
Dialogue: 0,0:00:24.62,0:00:25.78,Clip,,0,0,0,,seiner Frau da hat, ob die
Dialogue: 0,0:00:25.78,0:00:26.68,Clip,,0,0,0,,sich scheiden lassen, ob
Dialogue: 0,0:00:26.68,0:00:28.08,Clip,,0,0,0,,die zusammen bleiben, ob
Dialogue: 0,0:00:28.08,0:00:29.42,Clip,,0,0,0,,er seine Firmen schließt,
Dialogue: 0,0:00:29.46,0:00:30.82,Clip,,0,0,0,,umzieht, sonst was macht,
Dialogue: 0,0:00:30.94,0:00:31.70,Clip,,0,0,0,,aus der Öffentlichkeit
Dialogue: 0,0:00:31.70,0:00:32.78,Clip,,0,0,0,,verschwindelt und so.
Dialogue: 0,0:00:33.20,0:00:34.14,Clip,,0,0,0,,Das geht mich überhaupt
Dialogue: 0,0:00:34.14,0:00:35.14,Clip,,0,0,0,,gar {\c&H0022DDFF&}nichts{\c&H00FFFFFF&} an, ich habe
Dialogue: 0,0:00:35.14,0:00:36.06,Clip,,0,0,0,,dazu auch {\c&H0022DDFF&}nichts{\c&H00FFFFFF&} zu sagen.
