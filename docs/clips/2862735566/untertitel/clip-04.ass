Dialogue: 0,0:00:00.00,0:00:01.40,Clip,,0,0,0,,ich werde nächste woche
Dialogue: 0,0:00:01.40,0:00:02.30,Clip,,0,0,0,,dienstag werde ich noch
Dialogue: 0,0:00:02.30,0:00:03.30,Clip,,0,0,0,,einmal zum trainen gehen
Dialogue: 0,0:00:03.30,0:00:04.86,Clip,,0,0,0,,und probieren mitzumachen
Dialogue: 0,0:00:04.86,0:00:06.22,Clip,,0,0,0,,und das ist halt öde ich
Dialogue: 0,0:00:06.22,0:00:07.12,Clip,,0,0,0,,muss halt permanent drauf
Dialogue: 0,0:00:07.12,0:00:08.24,Clip,,0,0,0,,achten und das ist schon
Dialogue: 0,0:00:08.24,0:00:09.80,Clip,,0,0,0,,richtig scheiße ich kann
Dialogue: 0,0:00:09.80,0:00:11.10,Clip,,0,0,0,,keine 100 prozent geben
Dialogue: 0,0:00:11.10,0:00:11.88,Clip,,0,0,0,,ich kann nicht richtig
Dialogue: 0,0:00:11.88,0:00:13.86,Clip,,0,0,0,,sprinten ich kann nicht
Dialogue: 0,0:00:13.86,0:00:15.50,Clip,,0,0,0,,richtig mitmachen halt
Dialogue: 0,0:00:15.50,0:00:17.86,Clip,,0,0,0,,und beim trainen
Dialogue: 0,0:00:17.86,0:00:18.82,Clip,,0,0,0,,merke ich dass selber die
Dialogue: 0,0:00:18.82,0:00:20.29,Clip,,0,0,0,,anderen den anderen fällt das halt
