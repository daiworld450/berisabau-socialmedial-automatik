Dialogue: 0,0:00:00.00,0:00:00.72,Clip,,0,0,0,,wo sind deine Quellen?
Dialogue: 0,0:00:01.76,0:00:03.72,Clip,,0,0,0,,Die Quelle ist Jakob
Dialogue: 0,0:00:03.72,0:00:05.28,Clip,,0,0,0,,Rothschild. Mit anderen
Dialogue: 0,0:00:05.28,0:00:06.46,Clip,,0,0,0,,Worten, die die die
Dialogue: 0,0:00:06.46,0:00:07.40,Clip,,0,0,0,,Weltkriege und Ardo
Dialogue: 0,0:00:07.40,0:00:07.98,Clip,,0,0,0,,Vittlöpen jetzt nicht
Dialogue: 0,0:00:07.98,0:00:09.70,Clip,,0,0,0,,haben, sind auch dieselben
Dialogue: 0,0:00:09.70,0:00:11.06,Clip,,0,0,0,,wie 80 % des Landes
Dialogue: 0,0:00:11.06,0:00:12.00,Clip,,0,0,0,,Israelaert.
Dialogue: 0,0:00:12.92,0:00:13.86,Clip,,0,0,0,,Krank, Scheisse.
Dialogue: 0,0:00:14.62,0:00:15.38,Clip,,0,0,0,,Islamistische Terroristen
Dialogue: 0,0:00:15.38,0:00:16.70,Clip,,0,0,0,,sind keine wahre Muslime.
Dialogue: 0,0:00:17.20,0:00:18.76,Clip,,0,0,0,,Radikale Christen sind
Dialogue: 0,0:00:18.76,0:00:19.84,Clip,,0,0,0,,keine wahren Christen.
Dialogue: 0,0:00:20.04,0:00:21.58,Clip,,0,0,0,,Zynisten sind keine wahren
Dialogue: 0,0:00:21.58,0:00:23.28,Clip,,0,0,0,,Juden. Aha, guck mal
Dialogue: 0,0:00:23.28,0:00:24.28,Clip,,0,0,0,,schön, guck mal, gebt euch
Dialogue: 0,0:00:24.28,0:00:25.38,Clip,,0,0,0,,das nochmal. An {\c&H0022DDFF&}alle{\c&H00FFFFFF&}
Dialogue: 0,0:00:25.38,0:00:27.12,Clip,,0,0,0,,spaltenen Zungen. Hier,
Dialogue: 0,0:00:27.80,0:00:28.60,Clip,,0,0,0,,zum Mitschreiben bitte.
