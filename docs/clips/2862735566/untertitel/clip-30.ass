Dialogue: 0,0:00:00.00,0:00:01.16,Clip,,0,0,0,,Wenn ihr Unterschiede
Dialogue: 0,0:00:01.16,0:00:02.26,Clip,,0,0,0,,macht nur zwischen gute
Dialogue: 0,0:00:02.26,0:00:03.28,Clip,,0,0,0,,Menschen oder böse
Dialogue: 0,0:00:03.28,0:00:04.34,Clip,,0,0,0,,Menschen, {\c&H0022DDFF&}alles{\c&H00FFFFFF&} andere
Dialogue: 0,0:00:04.34,0:00:06.04,Clip,,0,0,0,,spielt keine Rolle.
Dialogue: 0,0:00:06.30,0:00:07.30,Clip,,0,0,0,,Wer sich trotzdem daran
Dialogue: 0,0:00:07.30,0:00:08.76,Clip,,0,0,0,,bedient, bedient sich an
Dialogue: 0,0:00:08.76,0:00:09.90,Clip,,0,0,0,,dem Spiel des Teufels.
Dialogue: 0,0:00:10.70,0:00:11.92,Clip,,0,0,0,,Und jetzt erkenne dich
Dialogue: 0,0:00:11.92,0:00:12.37,Clip,,0,0,0,,selbst.
Dialogue: 0,0:00:18.13,0:00:18.99,Clip,,0,0,0,,Das ist doch nicht schwer
Dialogue: 0,0:00:18.99,0:00:19.99,Clip,,0,0,0,,zu begreifen, Alter.
Dialogue: 0,0:00:20.81,0:00:21.61,Clip,,0,0,0,,{\c&H0022DDFF&}Wirklich,{\c&H00FFFFFF&} das ist doch
Dialogue: 0,0:00:21.61,0:00:22.67,Clip,,0,0,0,,nicht schwer zu begreifen,
Dialogue: 0,0:00:22.79,0:00:23.51,Clip,,0,0,0,,meine Güte.
Dialogue: 0,0:00:26.29,0:00:26.81,Clip,,0,0,0,,Wow.
Dialogue: 0,0:00:27.43,0:00:28.57,Clip,,0,0,0,,Ja, das Ding, das ging
Dialogue: 0,0:00:28.57,0:00:30.49,Clip,,0,0,0,,zwar nur 16 Minuten, Aber
Dialogue: 0,0:00:30.49,0:00:32.08,Clip,,0,0,0,,es hat es echt in sich, Leute.
